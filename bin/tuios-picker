#!/usr/bin/env python3
"""Fuzzy navigation through TUIOS's unmodified CLI and herdr-compatible API."""

import json
import fcntl
import hashlib
import os
from pathlib import Path
import socket
import shlex
import subprocess
import sys
import time
import tempfile
import unicodedata


def rpc(method, **params):
    runtime = os.environ.get("XDG_RUNTIME_DIR")
    default = Path(runtime) / "tuios/tuios.sock" if runtime else Path(f"/tmp/tuios-{os.getuid()}/tuios.sock")
    path = os.environ.get("TUIOS_SOCKET", str(default)) + ".herdr"
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
        connection.settimeout(20)
        connection.connect(path)
        request = {"id": "dotfiles-picker", "method": method, "params": params}
        connection.sendall((json.dumps(request) + "\n").encode())
        reply = json.loads(connection.makefile("rb").readline())
    if "error" in reply:
        raise RuntimeError(reply["error"]["message"])
    return reply["result"]


def cli(*args):
    return json.loads(subprocess.check_output(["tuios", *args, "--json"], text=True))


def clean(text):
    return " ".join("".join(c for c in str(text) if c.isprintable() or c in "\t\n").split())


def close_own_popup():
    window = os.environ.get("TUIOS_WINDOW_ID")
    target = os.environ.get("TUIOS_SESSION")
    if not window or not target:
        return
    try:
        if os.environ.get("TUIOS_PICKER_POPUP") != "1":
            # Also cover clients still using the earlier binding. A picker run
            # manually in an ordinary shell must never close that shell.
            info = cli("get-window", window, "-s", target)
            if info.get("custom_name") not in ("Fuzzy session 선택", "Fuzzy workspace 선택"):
                return
        rpc("pane.close", pane_id=window)
    except (OSError, ValueError, RuntimeError, subprocess.CalledProcessError):
        # The native exit path, or closing the selected session/workspace,
        # may already have removed this popup.
        pass


def cell_width(text):
    return sum(0 if unicodedata.combining(c) else 2 if unicodedata.east_asian_width(c) in ("W", "F") else 1
               for c in text)


def color_text(value, code):
    return f"\x1b[{code}m{value}\x1b[0m" if value else ""


def render_rows(rows, styled=False):
    """Keep search data intact; add spacing and optional display-only colors."""
    cleaned = [[("  └" if i == 1 and str(row[0]).startswith("pane:") else "  " + clean(value)
                 if i == 1 and str(row[0]).startswith("ws:") else clean(value))
                for i, value in enumerate(row)] for row in rows]
    if not cleaned:
        return ""
    widths = [min(32, max(cell_width(row[i]) if i < len(row) else 0 for row in cleaned))
              for i in range(max(map(len, cleaned)))]
    lines = []
    for row in cleaned:
        child = row[0].startswith(("pane:", "ws:"))
        fields = []
        for i, value in enumerate(row):
            padding = " " * (max(0, widths[i] - cell_width(value)) + 2) if 0 < i < len(row) - 1 else ""
            if styled and i > 0:
                if value == "current":
                    value = color_text(value, "38;2;158;206;106")
                elif i == 1:
                    value = color_text(value, "38;2;155;161;172" if child else "1;38;2;220;222;228")
                elif child and i == 3 and row[0].startswith("pane:"):
                    value = color_text("│ " + value, "38;2;174;180;190")
                elif child:
                    value = color_text(value, "38;2;202;207;216")
                else:
                    value = color_text(value, "1;38;2;220;222;228")
            fields.append(value + padding)
        lines.append("\t".join(fields) + "\n")
    return "".join(lines)


def short_path(value):
    path = clean(value)
    home = str(Path.home())
    if path == home or path.startswith(home + "/"):
        path = "~" + path[len(home):]
    return path


def fit_text(value, width):
    text = clean(value)
    if cell_width(text) <= width:
        return text
    result = ""
    for char in text:
        if cell_width(result + char) > max(0, width - 1):
            break
        result += char
    return result + "…" if width > 0 else ""


def header_line(left, right, width, left_color=None, right_color=None):
    right = fit_text(right, max(0, width // 2))
    left = fit_text(left, max(0, width - cell_width(right) - 2))
    gap = " " * max(1, width - cell_width(left) - cell_width(right))
    return (color_text(left, left_color) if left_color else left) + gap + (color_text(right, right_color) if right_color else right)


def filtered_rows(rows, kind, query):
    text = render_rows(rows)
    if not query:
        return text.splitlines()
    result = subprocess.run(
        ["fzf", "--filter", query, "--delimiter", "\t", "--with-nth", "2..",
         "--nth", "1" if kind == "session" else "1,2", "--extended", "--tiebreak=index"],
        input=text, text=True, stdout=subprocess.PIPE, check=False,
    )
    if result.returncode not in (0, 1):
        raise RuntimeError("검색 결과를 복원하지 못했습니다.")
    return result.stdout.splitlines()


def help_layout(kind, columns):
    title = "Sessions" if kind == "session" else "Workspaces"
    actions = ["Enter 이동"]
    actions += ["C-n/p 행", "C-j/k " + ("session" if kind == "session" else "WS"), "Tab/C-o 펼침", "C-g 전체", "C-u/d 스크롤"]
    actions += ["C-a 추가", "C-r 이름", "C-x 종료", "C-/ 미리보기", "Esc 닫기"]
    line = " · ".join(actions)
    if columns >= cell_width(line) + 10:
        # fzf's footer belongs to the list column. The outer border label spans
        # both the list and preview, so use it as a shared bottom key guide.
        return ["--border-label", f" {line} ", "--border-label-pos=2:bottom", "--no-footer"]
    footer = "Enter 이동 · Esc 닫기 · Ctrl-/ 미리보기"
    footer += "\nC-n/p 행 · C-j/k " + kind + "\nTab/C-o 펼침 · Ctrl-g 전체\nC-u/d 미리보기 스크롤"
    footer += "\nCtrl-a 추가 · Ctrl-r 이름 · Ctrl-x 종료"
    return ["--border-label", f" {title} ", "--border-label-pos=2", "--footer-border=top", "--footer", footer]


def choose(rows, kind, current=None, state=None, target=None):
    state = state if state is not None else {}
    query = state.get("query", "")
    visible = filtered_rows(rows, kind, query)
    ids = [row.split("\t", 1)[0] for row in visible]
    selected = state.get("selected", current)
    position = ids.index(selected) + 1 if selected in ids else min(state.get("position", 1), max(1, len(ids)))
    fields = "1" if kind == "session" else "1,2"
    preview = shlex.join([sys.executable, str(Path(__file__).resolve()), "_preview", kind, target or ""]) + " {1}"
    tree_keys = ["--expect=ctrl-a,ctrl-r,ctrl-x", "--bind=ctrl-n:down,ctrl-p:up,ctrl-u:preview-half-page-up,ctrl-d:preview-half-page-down"]
    title = "Sessions" if kind == "session" else "Workspaces"
    try:
        columns = os.get_terminal_size(2).columns
    except OSError:
        columns = 80
    help_options = help_layout(kind, columns)
    with tempfile.TemporaryDirectory(prefix="tuios-picker-") as directory:
        tree_state = Path(directory) / "tree.json"
        tree_state.write_text(json.dumps({"kind": kind, "current": current, "expanded": list(state.get("expanded", [])), "rows": rows}))
        if kind in ("session", "workspace"):
            toggle = shlex.join([sys.executable, str(Path(__file__).resolve()), "_toggle", target or "", str(tree_state)])
            for key in ("tab", "ctrl-o"):
                tree_keys += ["--bind", key + ":transform:" + toggle + " {1} {q}"]
            tree_keys += ["--bind", "ctrl-g:transform:" + toggle + " {1} {q} all"]
            jump = shlex.join([sys.executable, str(Path(__file__).resolve()), "_jump", str(tree_state)])
            for key, step in (("ctrl-j", "1"), ("ctrl-k", "-1")):
                tree_keys += ["--bind", key + ":transform:" + jump + " {1} {q} " + step]
        result = subprocess.run(
            ["fzf", "--prompt", "찾기 › ", "--ghost", "이름 검색" if kind == "session" else "이름 / 번호 검색",
             "--border=rounded", *help_options, "--ansi", "--padding=0,1",
             "--color=fg:#caced8,border:#5c626c,label:#c0c6d0,prompt:#d4d8e0,pointer:#7dcfff,hl:#e0af68,hl+:#e0af68,fg+:#f4f4f6,bg+:#383c45,info:#a7adb7,separator:#5c626c",
             "--input-border=bottom", "--info=inline-right", "--list-border=rounded", "--list-label", f" {title} ",
             "--list-label-pos=2", "--preview-label= Preview ", "--preview-label-pos=2",
             "--highlight-line", "--pointer=▌", "--tabstop=1", "--delimiter", "\t", "--with-nth", "2..", "--nth", fields,
             "--extended", "--layout=reverse", "--no-multi", "--cycle", "--sync", "--tiebreak=index",
             "--query", query, "--print-query", "--bind", f"start:pos({position})", "--bind=change:first",
             "--preview", preview, "--preview-window=right,60%,nowrap,noinfo,follow,border-rounded,~5,<35(down,35%,nowrap,noinfo,follow,border-rounded,~5)",
             "--bind=ctrl-/:toggle-preview,ctrl-_:toggle-preview", *tree_keys, "--bind=enter:accept-non-empty"],
            input=render_rows(rows, styled=True),
            text=True, stdout=subprocess.PIPE,
        )
        if kind in ("session", "workspace"):
            updated = json.loads(tree_state.read_text())
            state["expanded"] = set(updated["expanded"])
            rows = updated["rows"]
    if result.returncode == 130:
        return None, None
    lines = result.stdout.splitlines()
    state["query"] = lines[0] if lines else query
    key = lines[1] if len(lines) > 1 else ""
    selected = lines[2].split("\t", 1)[0] if len(lines) > 2 else None
    state["selected"] = selected
    if selected:
        ids = [row.split("\t", 1)[0] for row in filtered_rows(rows, kind, state["query"])]
        state["position"] = ids.index(selected) + 1 if selected in ids else 1
    if result.returncode == 1 and key != "ctrl-a":
        return None, None
    if result.returncode not in (0, 1):
        raise RuntimeError(f"fzf 종료 코드: {result.returncode}")
    return key, selected


def workspace_order(data):
    order = data.get("order") or []
    return sorted(data["workspaces"], key=lambda item: order.index(item["workspace"])
                  if item["workspace"] in order else len(order) + item["workspace"])


def workspace_rows(items, panes, expanded):
    rows = []
    for item in items:
        number = str(item["workspace"])
        members = [p for p in panes if p["workspace"] == item["workspace"]
                   and p["window_id"] != os.environ.get("TUIOS_WINDOW_ID")]
        if not (item.get("current") or item["window_count"] or item.get("name")):
            continue
        arrow = "▾" if number in expanded else "▸"
        rows.append((number, f"{arrow} {number}", item.get("name", ""),
                     "current" if item.get("current") else ""))
        if number in expanded:
            for pane in members:
                title = pane.get("custom_name") or pane.get("display_name") or pane.get("title") or "pane"
                rows.append((f"pane:{number}:{pane['window_id']}", "  └", title,
                             pane.get("foreground_cmd") or "shell", "current" if pane.get("focused") else ""))
    return rows


def session_name(workspace_id):
    name = next((s["name"] for s in cli("ls")
                 if ("w" + s["id"].replace("-", "")).startswith(workspace_id)), None)
    if name is None:
        raise RuntimeError("이미 종료된 session입니다.")
    return name


def session_rows(items, current, expanded):
    rows = []
    for item in items:
        ident = item["workspace_id"]
        arrow = "▾" if ident in expanded else "▸"
        rows.append((ident, f"{arrow} {item.get('label') or ident}",
                     "current" if ident == current else ""))
        if ident not in expanded:
            continue
        data = cli("list-workspaces", "-s", session_name(ident))
        for ws in workspace_order(data):
            if not (ws.get("current") or ws.get("window_count") or ws.get("name")):
                continue
            number = ws["workspace"]
            rows.append((f"ws:{ident}:{number}", f"  └ workspace {number} · {ws.get('name') or '이름 없음'}",
                         "current" if ident == current and ws.get("current") else ""))
    return rows


def tree_parent(selected):
    return selected.split(":", 2)[1] if selected.startswith(("pane:", "ws:")) else selected


def toggle_tree(target, state_path, selected="", query="", scope="one"):
    if not selected and scope != "all":
        return
    path = Path(state_path)
    state = json.loads(path.read_text())
    number = tree_parent(selected)
    expanded = set(state["expanded"])
    if scope == "all":
        parents = {row[0] for row in state["rows"] if tree_parent(row[0]) == row[0]}
        expanded = set() if parents <= expanded else parents
    else:
        expanded.symmetric_difference_update({number})
    kind = state.get("kind", "workspace")
    if kind == "session":
        # Keep the order from this picker opening stable while expanding.
        live = {item["workspace_id"]: item for item in rpc("workspace.list")["workspaces"]}
        items = [live[row[0]] for row in state["rows"] if row[0] in live]
        rows = session_rows(items, state.get("current"), expanded)
    else:
        items = workspace_order(cli("list-workspaces", "-s", target))
        panes = cli("list-windows", "-s", target)["windows"]
        rows = workspace_rows(items, panes, expanded)
    visible = [row.split("\t", 1)[0] for row in filtered_rows(rows, kind, query)]
    anchor = selected if scope == "all" and selected in visible else number
    position = visible.index(anchor) + 1 if anchor in visible else 1
    state.update(expanded=list(expanded), rows=rows)
    path.write_text(json.dumps(state))
    listing = path.with_suffix(".rows")
    listing.write_text(render_rows(rows, styled=True))
    print(f"reload-sync(cat {shlex.quote(str(listing))})+pos({position})")


def jump_workspace(state_path, selected="", query="", step="1"):
    state = json.loads(Path(state_path).read_text())
    ids = [row.split("\t", 1)[0] for row in filtered_rows(state["rows"], state.get("kind", "workspace"), query)]
    if selected not in ids:
        return
    parent = tree_parent(selected)
    index = ids.index(selected)
    direction = int(step)
    for offset in range(1, len(ids) + 1):
        candidate = (index + direction * offset) % len(ids)
        if not ids[candidate].startswith(("pane:", "ws:")) and ids[candidate] != parent:
            print(f"pos({candidate + 1})")
            return
    if parent in ids:
        print(f"pos({ids.index(parent) + 1})")


def ordered_sessions(items, target):
    history = session_history()
    clients = [item for item in cli("list-clients") if item.get("session") == target]
    recent = history.get(str(clients[0]["pid"]), []) if len(clients) == 1 else []
    sessions = cli("ls")
    def rank(item):
        session = next((s for s in sessions if ("w" + s["id"].replace("-", "")).startswith(item["workspace_id"])), {})
        uuid = session.get("id")
        return (recent.index(uuid), 0) if uuid in recent else (len(recent), -session.get("last_active", 0))
    return sorted(items, key=rank)


def preview(kind, target, selected):
    session_label = target
    workspace_number = None
    if kind == "session" and selected.startswith("ws:"):
        _, selected, workspace_number = selected.split(":", 2)
    if kind == "session":
        sessions = cli("ls")
        session = next((s for s in sessions if ("w" + s["id"].replace("-", "")).startswith(selected)), None)
        if not session:
            print("이미 종료된 session입니다.")
            return
        target = session["name"]
        session_label = session.get("display_name") or target
        if workspace_number is not None:
            kind, selected = "workspace", workspace_number
    else:
        session_label = cli("session-info", "-s", target).get("display_name") or target
    selected_pane = None
    if kind == "workspace" and selected.startswith("pane:"):
        _, selected, selected_pane = selected.split(":", 2)
    data = cli("list-workspaces", "-s", target)
    windows = cli("list-windows", "-s", target)
    panes = [p for p in windows["windows"] if p["window_id"] != os.environ.get("TUIOS_WINDOW_ID")]
    workspaces = workspace_order(data)
    ws = next((w for w in workspaces if str(w["workspace"]) == selected), None) if kind == "workspace" else next(
        (w for w in workspaces if w.get("current")), None)
    if ws is None:
        print("이미 종료된 workspace입니다.")
        return
    members = [p for p in panes if p["workspace"] == ws["workspace"]]
    pane = next((p for p in members if p["window_id"] == selected_pane), None) if selected_pane else None
    if selected_pane and pane is None:
        print("이미 종료된 pane입니다.")
        return
    if pane is None:
        # The picker popup temporarily owns focus. Use the most recently
        # focused real pane, including when previewing another workspace.
        history = [ws.get("focused_window_id"), *ws.get("focus_history", [])]
        pane = next((p for ident in history for p in members if p["window_id"] == ident), None)
        if pane is None:
            pane = next((p for p in members if p.get("focused")), members[0] if members else None)
    width = max(10, int(os.environ.get("FZF_PREVIEW_COLUMNS", "60")) - 2)
    breadcrumb = f"{session_label} › {ws['workspace']} {ws.get('name') or '이름 없음'}"
    if pane is None:
        print(fit_text(breadcrumb, width))
        print("\n(빈 workspace)")
        return
    title = pane.get("custom_name") or pane.get("display_name") or pane.get("title") or "pane"
    command = pane.get("foreground_cmd") or windows.get("shell") or "shell"
    print()
    print(" " + header_line(f"● {title}  [{command}]", breadcrumb, width, "1;38;2;220;222;228", "38;2;188;194;204"))
    status = "current" if pane.get("focused") else ""
    print(" " + header_line(short_path(pane.get("cwd") or ""), status, width, "38;2;167;173;183", "38;2;158;206;106"))
    print(" " + color_text("─" * width, "38;2;92;98;108"))
    print()
    screen = subprocess.check_output(
        ["tuios", "capture-pane", "-s", target, "-w", pane["window_id"], "--ansi"],
        text=True, stderr=subprocess.DEVNULL, timeout=5,
    )
    for line in screen.splitlines():
        print(" " + line)


def confirm_close(kind, label, panes):
    result = subprocess.run(
        ["fzf", "--prompt", "종료 확인> ", "--layout=reverse", "--no-multi",
         "--header", f"{kind} '{clean(label)}' 종료 · {panes} panes · y: 종료 / n, Esc: 취소",
         "--bind=y:pos(2)+accept,n:abort"],
        input="취소\n종료\n", text=True, stdout=subprocess.PIPE,
    )
    return result.returncode == 0 and result.stdout.strip() == "종료"


def session_workspace_id(target):
    opaque = "w" + cli("session-info", "-s", target)["session_id"].replace("-", "")
    return rpc("workspace.get", workspace_id=opaque)["workspace"]["workspace_id"]


def close_target(kind, selected, current, target):
    """Run outside the popup's process group, which closing may terminate."""
    state = Path(os.environ.get("XDG_STATE_HOME", str(Path.home() / ".local/state"))) / "dotfiles-tuios"
    state.mkdir(parents=True, exist_ok=True)
    with (state / "close.log").open("a") as log:
        subprocess.Popen(
            [sys.executable, str(Path(__file__).resolve()), "_close", kind, selected, current, target],
            stdin=subprocess.DEVNULL, stdout=log, stderr=log, start_new_session=True,
        )


def finish_close(kind, selected, current, target):
    if kind == "session":
        if selected == current:
            items = rpc("workspace.list")["workspaces"]
            index = next(i for i, item in enumerate(items) if item["workspace_id"] == current)
            others = items[index + 1:] + items[:index]
            if others:
                sessions = cli("ls")
                next_id = others[0]["workspace_id"]
                destination = next(item["name"] for item in sessions
                                   if ("w" + item["id"].replace("-", "")).startswith(next_id))
                clients = [item for item in cli("list-clients") if item["session"] == target]
                if len(clients) > 1:
                    raise RuntimeError("현재 세션에 여러 client가 연결되어 있어 자동 이동할 client를 정할 수 없습니다.")
                if clients:
                    client = clients[0]["client_id"]
                    cli("switch-session", destination, "--client", client)
                    # switch-session requests a switch asynchronously. Killing
                    # before the client attaches would still disconnect it.
                    deadline = time.monotonic() + 10
                    while not any(item["client_id"] == client and item["session"] == destination
                                  for item in cli("list-clients")):
                        if time.monotonic() >= deadline:
                            raise RuntimeError("다른 세션으로 이동하지 못해 현재 세션 종료를 취소했습니다.")
                        time.sleep(0.05)
        rpc("workspace.close", workspace_id=selected)
    else:
        tabs = rpc("tab.list", workspace_id=session_workspace_id(target))["tabs"]
        tab = next(item for item in tabs if item["number"] == int(selected))
        rpc("tab.close", tab_id=tab["tab_id"])


def close_current(kind, target):
    if kind == "session":
        current = session_workspace_id(target)
        item = rpc("workspace.get", workspace_id=current)["workspace"]
        label, panes = item.get("label") or target, item["pane_count"]
    else:
        items = cli("list-workspaces", "-s", target)["workspaces"]
        item = next(item for item in items if item.get("current"))
        current = str(item["workspace"])
        label, panes = item.get("name") or current, item["window_count"]
    if confirm_close(kind, label, panes):
        close_target(kind, current, current, target)


def cycle_workspace(target, step):
    data = cli("list-workspaces", "-s", target)
    items = [item for item in data["workspaces"]
             if item.get("current") or item.get("window_count") or item.get("name")]
    order = data.get("order") or []
    items.sort(key=lambda item: order.index(item["workspace"]) if item["workspace"] in order
               else len(order) + item["workspace"])
    current = next((i for i, item in enumerate(items) if item.get("current")), None)
    if current is None:
        raise RuntimeError("현재 workspace를 찾을 수 없습니다.")
    if len(items) > 1:
        destination = items[(current + step) % len(items)]["workspace"]
        cli("select-workspace", str(destination), "-s", target)


def session_history(target=None):
    """Sample live clients on attach; keep history by client process, not pane."""
    state = Path(os.environ.get("XDG_STATE_HOME", str(Path.home() / ".local/state"))) / "dotfiles-tuios"
    state.mkdir(parents=True, exist_ok=True)
    socket_key = hashlib.sha256(os.environ.get("TUIOS_SOCKET", "default").encode()).hexdigest()[:16]
    path = state / f"session-history-{socket_key}.json"
    with (state / f"session-history-{socket_key}.lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        sessions = cli("ls")
        by_name = {item["name"]: item["id"] for item in sessions}
        by_id = {item["id"]: item["name"] for item in sessions}
        clients = [item for item in cli("list-clients") if item.get("session") in by_name]
        try:
            history = json.loads(path.read_text())
        except (FileNotFoundError, json.JSONDecodeError):
            history = {}
        live = {}
        for client in clients:
            key = str(client["pid"])
            current = by_name[client["session"]]
            live[key] = [current] + [item for item in history.get(key, [])
                                     if item != current and item in by_id][:19]
        temporary = path.with_suffix(".tmp")
        temporary.write_text(json.dumps(live))
        temporary.replace(path)
        if target is None:
            return live
        matches = [item for item in clients if item["session"] == target]
        if len(matches) != 1:
            raise RuntimeError("직전 세션 이동에는 현재 세션에 연결된 client가 하나여야 합니다.")
        client = matches[0]
        recent = live[str(client["pid"])]
        if len(recent) < 2:
            return
        cli("switch-session", by_id[recent[1]], "--client", client["client_id"])


def main(state=None):
    state = state if state is not None else {}
    kind = sys.argv[1] if len(sys.argv) > 1 else "sessions"
    if kind == "record-session":
        session_history()
        return
    target = os.environ.get("TUIOS_SESSION")
    if not target:
        raise RuntimeError("TUIOS 안에서 실행하세요.")
    if kind == "last-session":
        session_history(target)
        return
    if kind in ("next-workspace", "prev-workspace"):
        cycle_workspace(target, 1 if kind == "next-workspace" else -1)
        return
    if kind in ("close-session", "close-workspace"):
        close_current(kind.removeprefix("close-"), target)
        return
    if kind == "sessions":
        items = ordered_sessions(rpc("workspace.list")["workspaces"], target)
        info = cli("session-info", "-s", target)
        current = rpc("workspace.get", workspace_id="w" + info["session_id"].replace("-", ""))["workspace"]["workspace_id"]
        rows = session_rows(items, current, state.setdefault("expanded", {item["workspace_id"] for item in items}))
        key, selected = choose(rows, "session", current, state, target)
        item = next((item for item in items if item["workspace_id"] == selected), None)
        if selected and selected.startswith("ws:"):
            if key == "":
                _, parent, number = selected.split(":", 2)
                cli("select-workspace", number, "-s", session_name(parent))
                rpc("workspace.focus", workspace_id=parent)
                return
            if key == "ctrl-x":
                _, parent, number = selected.split(":", 2)
                destination = session_name(parent)
                workspaces = cli("list-workspaces", "-s", destination)["workspaces"]
                workspace = next((w for w in workspaces if str(w["workspace"]) == number), None)
                if workspace and confirm_close("workspace", workspace.get("name") or number, workspace["window_count"]):
                    active = next((str(w["workspace"]) for w in workspaces if w.get("current")), "")
                    if parent == current and number == active:
                        close_target("workspace", number, active, destination)
                        return
                    finish_close("workspace", number, active, destination)
                    state["selected"] = parent
                return True
            if key != "ctrl-a":
                return True
        if key == "ctrl-a":
            name = input("새 session 이름 (빈 입력: 취소)> ").strip()
            if name:
                created = rpc("workspace.create", label=name, cwd=os.environ.get("TUIOS_ACTIVE_PANE_CWD", os.getcwd()))
                rpc("workspace.focus", workspace_id=created["workspace"]["workspace_id"])
        elif key == "ctrl-r" and item:
            name = input(f"session '{clean(item.get('label') or selected)}' 새 표시 이름 (빈 입력: 취소)> ").strip()
            if name:
                rpc("workspace.rename", workspace_id=selected, label=name)
            return True
        elif key == "ctrl-x" and item:
            if confirm_close("session", item.get("label") or selected, item["pane_count"]):
                if selected == current:
                    close_target("session", selected, current, target)
                    return
                finish_close("session", selected, current, target)
                state["selected"] = None
            return True
        elif key in ("ctrl-r", "ctrl-x"):
            return True
        elif selected:
            rpc("workspace.focus", workspace_id=selected)
    elif kind == "workspaces":
        items = workspace_order(cli("list-workspaces", "-s", target))
        panes = cli("list-windows", "-s", target)["windows"]
        expanded = state.setdefault("expanded", {str(item["workspace"]) for item in items})
        rows = workspace_rows(items, panes, expanded)
        current = next((str(item["workspace"]) for item in items if item.get("current")), None)
        key, selected = choose(rows, "workspace", current, state, target)
        item = next((item for item in items if str(item["workspace"]) == selected), None)
        if selected and selected.startswith("pane:"):
            if key == "":
                pane_id = selected.split(":", 2)[2]
                cli("focus-window", pane_id, "-s", target)
                return
            if key == "ctrl-x":
                _, number, pane_id = selected.split(":", 2)
                pane = next((p for p in panes if p["window_id"] == pane_id), None)
                if pane:
                    label = pane.get("custom_name") or pane.get("display_name") or pane.get("title") or pane_id
                    if confirm_close("pane", label, 1):
                        rpc("pane.close", pane_id=pane_id)
                        state["selected"] = number
                return True
            if key != "ctrl-a":
                return True
        if key == "ctrl-a":
            subprocess.run([str(Path(__file__).resolve().with_name("tuios-trial")), "new-workspace"], check=True)
        elif key == "ctrl-r" and item:
            name = input(f"workspace {selected} 새 이름 (빈 입력: 취소)> ").strip()
            if name:
                subprocess.run(["tuios", "set-workspace-name", selected, name, "-s", target],
                               check=True, stdout=subprocess.DEVNULL)
            return True
        elif key == "ctrl-x" and item:
            if confirm_close("workspace", item.get("name") or selected, item["window_count"]):
                if selected == current:
                    close_target("workspace", selected, current, target)
                    return
                finish_close("workspace", selected, current, target)
                state["selected"] = None
            return True
        elif key in ("ctrl-r", "ctrl-x"):
            return True
        elif selected:
            cli("select-workspace", selected, "-s", target)
    else:
        raise RuntimeError(f"알 수 없는 picker: {kind}")


if __name__ == "__main__":
    try:
        if len(sys.argv) > 1 and sys.argv[1] == "_preview":
            try:
                preview(*sys.argv[2:])
            except (OSError, ValueError, RuntimeError, subprocess.CalledProcessError):
                print("대상이 변경되어 미리보기를 불러오지 못했습니다.")
        elif len(sys.argv) > 1 and sys.argv[1] == "_toggle":
            toggle_tree(*sys.argv[2:])
        elif len(sys.argv) > 1 and sys.argv[1] == "_jump":
            jump_workspace(*sys.argv[2:])
        elif len(sys.argv) > 1 and sys.argv[1] == "_close":
            finish_close(*sys.argv[2:])
        else:
            picker_state = {}
            while main(picker_state):
                pass
    except (EOFError, KeyboardInterrupt, BrokenPipeError):
        pass
    except (OSError, ValueError, RuntimeError, subprocess.CalledProcessError) as error:
        print(f"tuios-picker: {error}", file=sys.stderr)
        sys.exit(1)
    finally:
        if len(sys.argv) < 2 or sys.argv[1] not in ("_close", "_preview", "_toggle", "_jump", "next-workspace", "prev-workspace", "record-session", "last-session"):
            close_own_popup()
