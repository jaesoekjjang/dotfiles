#!/bin/zsh
# Compile on first use and after source changes; ordinary hooks run the cache.
emulate -LR zsh
setopt errexit pipefail

picker_root=${0:A:h:h}/tuios/picker
picker_key=$(print -rn -- "$picker_root-$MACHTYPE" | cksum)
picker_key=${picker_key%% *}
picker_cache=${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles-tuios/picker-$picker_key
picker_sources=("$picker_root/go.mod" "$picker_root/go.sum" "$picker_root"/*.go(N) "$picker_root"/internal/**/*.go(N))
picker_signature=$(cksum "${picker_sources[@]}")
picker_version=$(print -rn -- "$picker_signature" | cksum)
picker_version=${picker_version%% *}
picker_binary=$picker_cache/$picker_version/tuios-picker

if [[ ! -x "$picker_binary" ]]; then
  (( $+commands[go] )) || { print -u2 'tuios-picker: Go가 필요합니다. brew install go'; exit 1; }
  mkdir -p "${picker_binary:h}"
  chmod 700 "$picker_cache"
  picker_temporary=$(mktemp "${picker_binary:h}/.build.XXXXXX")
  trap 'rm -f -- "$picker_temporary"' EXIT
  (cd "$picker_root"; go build -trimpath -o "$picker_temporary" .)
  mv -f "$picker_temporary" "$picker_binary"
fi

[[ "${1:-}" == --build ]] && { print -r -- "$picker_binary"; exit 0; }
export TUIOS_PICKER_TRIAL=${0:A:h}/tuios-trial
exec "$picker_binary" "$@"
