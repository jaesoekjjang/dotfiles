#!/bin/zsh -l

local raw_name=$(basename "$PWD")
local session_name=${raw_name//[^a-zA-Z0-9_-]/_}

if tmux has-session -t "$session_name" 2>/dev/null; then
  tmux attach-session -t "$session_name"
else
  # 1. 세션 생성 (detached, 임시 윈도우)
  tmux new-session -s "$session_name" -n shell -d

  if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    # 2. 0번 윈도우를 git(lazygit)으로 교체
    tmux kill-window -t "$session_name:0"
    tmux new-window -t "$session_name:0" -n git lazygit

    # 3. 1번 윈도우(shell) 생성
    tmux new-window -t "$session_name:1" -n shell
  else
    tmux rename-window -t "$session_name:0" shell
  fi

  # 4. shell 윈도우를 vsplit
  tmux split-window -h -t "$session_name:1"

  # 5. attach → 마지막 윈도우(= shell)에 자동 포커스
  tmux attach-session -t "$session_name"
fi