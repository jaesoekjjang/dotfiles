#!/usr/bin/env zsh

file="$1"
line="$2"

case "$(basename "${EDITOR%% *}")" in
  vim|nvim)
    exec $EDITOR +"$line" "$file"
    ;;
  code|cursor)
    exec $EDITOR -g "$file:$line"
    ;;
  *)
    exec $EDITOR "$file"
    ;;
esac

// 1안
 {
    "data": {
      "card_no": 100000003,
      "monthly_total_amount": 405330,
      "pending_count": 10,
      "pending_amount": 300000,
      "progress_count": 1,
      "progress_amount": 50000,
      "complete_count": 1,
      "complete_amount": 55330,
      "return_count": 0,
      "return_amount": 0
    }
  }
// 2안 
 {
    "data": {
      "card_no": 100000003,
      "monthly_total_amount": 405330,
      "counts": {
        "pending": 10,
        "progress": 1,
        "complete": 1,
        "return": 0
      },
      "amounts": {
        "pending": 300000,
        "progress": 50000,
        "complete": 55330,
        "return": 0
      }
    }
  }
// 3안
{
    "data": {
      "card_no": 100000003,
      "monthly_total_amount": 405330,
      "stats": [
        { "status": "pending", "count": 10, "amount":
  300000 },
        { "status": "progress", "count": 1, "amount":
  50000 },
        { "status": "complete", "count": 1, "amount":
  55330 },
        { "status": "return", "count": 0, "amount": 0 }
      ]
    }
  }