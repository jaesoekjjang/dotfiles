# Window
# Start every new surface in the most recent TUIOS session; keep a shell fallback.
command = shell:/bin/zsh -l ~/.local/bin/tuios-start
title = " "
macos-titlebar-style = hidden
window-padding-color = extend
quit-after-last-window-closed = false

# Quick Terminal
keybind = global:ctrl+m=toggle_quick_terminal
quick-terminal-position = center
quick-terminal-screen = main
quick-terminal-animation-duration = 0.15
quick-terminal-size = 85%,85%
quick-terminal-space-behavior = remain

# Appearance
background-opacity = 1
background-blur = 10
mouse-hide-while-typing = true

# Follow the colors drawn by the active app, including light/dark TUIOS themes.
cursor-color = cell-foreground
cursor-text = cell-background

# Font
# Iosevka Term Extended: official IosevkaTerm Extended TTFs (v34.9.0).
font-family = "Iosevka Term Extended"
font-family = "D2CodingLigature Nerd Font Mono"
# Hangul only; Latin and Nerd icons keep their existing fonts.
# Change only the font name after the last "=" on the line below:
# NanumGothicCoding | D2CodingLigature Nerd Font
# After changing, reload config and open a new window.
# font-codepoint-map = U+1100-U+11FF,U+3130-U+318F,U+A960-U+A97F,U+AC00-U+D7AF,U+D7B0-U+D7FF,U+FFA0-U+FFDC="D2CodingLigature Nerd Font"
font-thicken = true
font-thicken-strength = 128
font-size = 18

# Clipboard
clipboard-read = allow
clipboard-write = allow
clipboard-paste-protection = false
clipboard-paste-bracketed-safe = true
copy-on-select = clipboard

# Keybindings
keybind = shift+enter=text:\n
