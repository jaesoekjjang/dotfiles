[core]
	eol = native
	ignorecase = false
	pager = delta
	editor = nvim
[init]
	defaultBranch = main
[http]
	sslVerify = false
[delta]
	side-by-side = true
[fetch]
	prune = true
[rebase]
	updateRefs = true
[include]
	path = ~/.gitconfig.local
[coderabbit]
	machineId = cli/71b768b4e6144782a5a0e22848c012de
